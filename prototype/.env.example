# Canonical origin. Everything canonical, hreflang, Open Graph and the
# sitemap is built against it, so it must match the host the site is served
# from — including the www prefix.
NEXT_PUBLIC_BASE_URL=https://www.remonta.pl

# Site ownership tokens. Paste the value from the provider's HTML-tag
# verification method (the content="..." part, not the whole tag), then
# redeploy. Leave unset and no meta tag is emitted.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Transactional email (PDF delivery). Without RESEND_API_KEY the
# /api/email-pdf route answers 503 NOT_CONFIGURED and the PDF is only
# downloaded in the browser, never emailed.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Supabase (subscriber storage)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
